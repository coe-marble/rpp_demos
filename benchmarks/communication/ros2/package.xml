  <version>0.1.0</version>
  <description>Matched RPP plugin and ROS node communication benchmarks.</description>
  <maintainer email="maintainers@rpp.dev">RPP maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>rmw</depend>
